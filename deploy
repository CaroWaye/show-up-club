#!/bin/bash
# Publishes the app (public/) to the website folder. It's plain files: your data lives on
# your phone, never on the server.

# Stop on the first failure, so we never print "complete" after an error
set -euo pipefail

# Run from the project folder, wherever the script is called from
cd "$(dirname "$0")"

# Check if the .env file exists
if [ -f .env ]; then
  # Enable auto-export
  set -a
  source .env
  # Disable auto-export
  set +a
else
  echo "Error: .env file not found!"
  exit 1
fi

# The app gets a folder of its own, so a deploy can never touch the rest of your site
case "${REMOTE_DEST%/}" in
  */public_html | */www)
    echo "Error: REMOTE_DEST is your whole website folder. Use a subfolder of its own, e.g. $REMOTE_DEST/show-up-club"
    exit 1
    ;;
esac

# The installed app only works offline with files listed in public/sw.js, so check none are missing
MISSING=$(cd public && find . -type f ! -name sw.js ! -name .DS_Store ! -name .show-up-club ! -name '*LICENSE*' | sed 's|^\./||' | sort |
  while read -r file; do grep -qF "'$file'" sw.js || echo "  $file"; done)
if [ -n "$MISSING" ]; then
  echo "Error: add these to APP_FILES in public/sw.js, or the app won't have them offline:"
  echo "$MISSING"
  exit 1
fi

SSH="ssh -p $REMOTE_PORT -i $REMOTE_SSH_KEY_PATH"

echo "🚀 Starting deployment to $REMOTE_HOST..."

# Only deploy into a new or empty folder, or one a previous deploy made (it has the
# .show-up-club marker file). Anything else might be someone's files, so leave it alone.
if ! $SSH "$REMOTE_USER@$REMOTE_HOST" \
  "mkdir -p '$REMOTE_DEST' && cd '$REMOTE_DEST' && { [ -f .show-up-club ] || [ -z \"\$(ls -A)\" ]; }"; then
  echo "Error: $REMOTE_DEST already has files that weren't put there by this script."
  echo "Nothing was changed. Pick a different REMOTE_DEST, or empty that folder yourself first."
  exit 1
fi

# The folder becomes an exact copy of public/; nothing outside it is touched.
rsync -avz --delete \
  --exclude '.DS_Store' \
  -e "$SSH" \
  public/ "$REMOTE_USER@$REMOTE_HOST:$REMOTE_DEST/"

echo "✅ Deployment complete! Open https://<your domain>/$(basename "$REMOTE_DEST")/ on your phone in Chrome, then ⋮ → Install app."
